import { useState } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { 
  ClipboardList, 
  ChevronRight, 
  ChevronLeft, 
  Home as HomeIcon, 
  Sun, 
  Battery, 
  Car, 
  Thermometer,
  Zap,
  ShieldCheck,
  CheckCircle,
  Download,
  Share2
} from 'lucide-react';
import { cn } from '../lib/utils';

export default function Roadmap() {
  const [step, setStep] = useState(1);
  const [data, setData] = useState<any>({
    homeType: 'Semi-detached',
    epc: 'D',
    hasSolar: false,
    hasBattery: false,
    hasEV: false,
    heating: 'Gas Boiler'
  });

  const nextStep = () => setStep(prev => prev + 1);
  const prevStep = () => setStep(prev => prev - 1);

  const steps = [
    { title: 'Home Profile', icon: HomeIcon },
    { title: 'Current Setup', icon: Zap },
    { title: 'Sustainability', icon: Sun },
    { title: 'Your Blueprint', icon: ShieldCheck },
  ];

  const renderStep = () => {
    switch (step) {
      case 1:
        return (
          <div className="space-y-8">
            <h2 className="text-2xl font-bold">First, tell us about your home</h2>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {['Detached', 'Semi-detached', 'Terraced', 'Flat', 'Bungalow'].map(t => (
                <button 
                  key={t}
                  onClick={() => setData({...data, homeType: t})}
                  className={cn(
                    "p-6 rounded-2xl border text-left transition-all",
                    data.homeType === t ? "border-brand-yellow bg-brand-yellow/5 ring-1 ring-brand-yellow" : "border-brand-grey-light/20"
                  )}
                >
                  <span className="font-bold">{t}</span>
                </button>
              ))}
            </div>
            <div className="space-y-4">
              <label className="block text-xs font-bold uppercase tracking-wider text-brand-grey">Estimated EPC Rating</label>
              <div className="flex space-x-2">
                {['A','B','C','D','E','F','G'].map(r => (
                  <button 
                    key={r}
                    onClick={() => setData({...data, epc: r})}
                    className={cn(
                      "w-10 h-10 rounded-lg flex items-center justify-center font-bold text-sm transition-all",
                      data.epc === r ? "bg-brand-yellow text-brand-black" : "glass"
                    )}
                  >
                    {r}
                  </button>
                ))}
              </div>
            </div>
          </div>
        );
      case 2:
        return (
          <div className="space-y-8">
            <h2 className="text-2xl font-bold">What's your current energy setup?</h2>
            <div className="space-y-4">
              <label className="flex items-center justify-between p-6 glass rounded-2xl cursor-pointer">
                <div className="flex items-center space-x-4">
                  <Thermometer size={24} className="text-brand-grey" />
                  <div>
                    <div className="font-bold">Current Heating</div>
                    <div className="text-xs text-brand-grey">Boiler, electric, or heat pump</div>
                  </div>
                </div>
                <select 
                  value={data.heating}
                  onChange={e => setData({...data, heating: e.target.value})}
                  className="bg-transparent border-none outline-none font-bold text-right"
                >
                  <option>Gas Boiler</option>
                  <option>Oil Boiler</option>
                  <option>Electric Heaters</option>
                  <option>Heat Pump</option>
                </select>
              </label>
              <div className="grid grid-cols-2 gap-4">
                <button 
                  onClick={() => setData({...data, hasSolar: !data.hasSolar})}
                  className={cn(
                    "p-6 rounded-2xl border text-left transition-all flex flex-col items-center space-y-4",
                    data.hasSolar ? "border-brand-yellow bg-brand-yellow/5" : "border-brand-grey-light/20"
                  )}
                >
                  <Sun size={32} className={data.hasSolar ? "text-brand-yellow" : "text-brand-grey"} />
                  <span className="font-bold">Solar Panels</span>
                </button>
                <button 
                   onClick={() => setData({...data, hasEV: !data.hasEV})}
                   className={cn(
                    "p-6 rounded-2xl border text-left transition-all flex flex-col items-center space-y-4",
                    data.hasEV ? "border-blue-500 bg-blue-500/5" : "border-brand-grey-light/20"
                  )}
                >
                  <Car size={32} className={data.hasEV ? "text-blue-500" : "text-brand-grey"} />
                  <span className="font-bold">EV Charger</span>
                </button>
              </div>
            </div>
          </div>
        );
      case 4:
        return (
          <div className="space-y-8">
            <div className="text-center space-y-4">
              <div className="inline-flex p-4 bg-green-500/10 text-green-500 rounded-full mb-4">
                <ShieldCheck size={48} />
              </div>
              <h2 className="text-3xl font-display font-bold">Your Energy Roadmap is Ready</h2>
              <p className="text-brand-grey">Based on being a {data.homeType} with EPC {data.epc}.</p>
            </div>

            <div className="space-y-4 p-2">
              <div className="flex items-start space-x-4 p-6 glass rounded-[32px] border-l-4 border-l-brand-yellow">
                <div className="text-2xl font-display font-bold text-brand-yellow">01</div>
                <div>
                  <h4 className="font-bold mb-1">Fabric First (Insulation)</h4>
                  <p className="text-sm text-brand-grey leading-relaxed">
                    Prioritise loft insulation and draft proofing. This is the cheapest way to reduce load before 
                    downsizing your future heat pump requirement.
                  </p>
                </div>
              </div>
              <div className="flex items-start space-x-4 p-6 glass rounded-[32px] border-l-4 border-l-brand-yellow">
                <div className="text-2xl font-display font-bold text-brand-yellow">02</div>
                <div>
                  <h4 className="font-bold mb-1">Solar PV Array (6.4kW)</h4>
                  <p className="text-sm text-brand-grey leading-relaxed">
                    Install a South/East hybrid array to maximize daily generation. Avoid small 2-3kW systems as 
                    installer overhead makes them less cost-effective.
                  </p>
                </div>
              </div>
              <div className="flex items-start space-x-4 p-6 glass rounded-[32px] border-l-4 border-l-brand-yellow">
                <div className="text-2xl font-display font-bold text-brand-yellow">03</div>
                <div>
                  <h4 className="font-bold mb-1">Smart Tariff Shifting</h4>
                  <p className="text-sm text-brand-grey leading-relaxed">
                    Move to Octopus Intelligent or Agile. Use a 10kWh battery to bridge your 4pm-7pm peak demands 
                    with cheap morning energy.
                  </p>
                </div>
              </div>
            </div>

            <div className="flex flex-col sm:flex-row gap-4 pt-8">
              <button className="flex-1 py-4 bg-brand-yellow text-brand-black font-bold rounded-2xl flex items-center justify-center gap-2">
                <Download size={18} />
                Download PDF
              </button>
              <button className="flex-1 py-4 glass font-bold rounded-2xl flex items-center justify-center gap-2">
                <Share2 size={18} />
                Share Analysis
              </button>
            </div>
          </div>
        );
      default: return <div>Step {step}</div>;
    }
  };

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div className="mb-12">
        <h1 className="text-4xl font-display font-bold mb-4">Home Energy Roadmap</h1>
        <p className="text-brand-grey max-w-2xl">
          Get a personalised, step-by-step plan for your home. No bias, just logic.
        </p>
      </div>

      <div className="max-w-3xl mx-auto">
        {/* Progress Bar */}
        <div className="flex items-center justify-between mb-16 relative">
          <div className="absolute top-1/2 left-0 right-0 h-0.5 bg-brand-grey-light/20 -translate-y-1/2 -z-10" />
          {steps.map((s, i) => (
            <div key={i} className="flex flex-col items-center space-y-2">
              <div className={cn(
                "w-12 h-12 rounded-full flex items-center justify-center transition-all duration-500",
                step > i + 1 ? "bg-green-500 text-white" : step === i + 1 ? "bg-brand-yellow text-brand-black scale-125" : "glass text-brand-grey"
              )}>
                {step > i + 1 ? <CheckCircle size={20} /> : <s.icon size={20} />}
              </div>
              <span className={cn("text-[10px] font-bold uppercase tracking-widest", step === i + 1 ? "text-brand-yellow" : "text-brand-grey")}>
                {s.title}
              </span>
            </div>
          ))}
        </div>

        <motion.div 
          key={step}
          initial={{ opacity: 0, x: 20 }}
          animate={{ opacity: 1, x: 0 }}
          className="glass p-12 rounded-[40px]"
        >
          {renderStep()}

          {step < 4 && (
            <div className="flex items-center justify-between mt-12 pt-8 border-t border-brand-grey-light/20 dark:border-white/5">
              <button 
                onClick={prevStep}
                disabled={step === 1}
                className="flex items-center space-x-2 text-brand-grey disabled:opacity-0 transition-all font-bold"
              >
                <ChevronLeft size={20} />
                <span>Back</span>
              </button>
              <button 
                onClick={nextStep}
                className="px-10 py-4 bg-brand-black text-white dark:bg-brand-yellow dark:text-brand-black rounded-2xl font-bold flex items-center group transition-transform active:scale-95"
              >
                <span>{step === 3 ? 'Generate Roadmap' : 'Next Step'}</span>
                <ChevronRight size={20} className="ml-1 group-hover:translate-x-1 transition-transform" />
              </button>
            </div>
          )}
        </motion.div>
      </div>
    </div>
  );
}
