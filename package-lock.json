rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Chat sessions
    match /chats/{chatId} {
      allow get: if true; // Allow anyone to get a chat session if they have the ID
      allow create: if true; // Allow initial session creation
      
      match /messages/{messageId} {
        function isValidMessage(data) {
          return data.keys().hasAll(['userId', 'content', 'role', 'timestamp']) &&
                 data.keys().size() == 4 &&
                 data.userId is string && data.userId.size() <= 128 &&
                 data.content is string && data.content.size() <= 4000 &&
                 data.role in ['user', 'model'] &&
                 data.timestamp is timestamp;
        }

        allow list: if true; // Allow listing messages for a chat if they have the ID
        allow create: if isValidMessage(incoming());
      }
    }
  }
}
